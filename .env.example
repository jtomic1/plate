# Local development defaults. Copy to .env (git-ignored): Copy-Item .env.example .env

# --- PostgreSQL container (read by docker-compose.yml) ---
POSTGRES_USER=plate
POSTGRES_PASSWORD=plate
POSTGRES_DB=plate
#Use 5433 if a local PostgreSQL already listens on 5432 (update DATABASE_URL accordingly)
POSTGRES_PORT=5432

# --- API (used from Phase 4) ---
# Must match the values above
DATABASE_URL=postgresql://plate:plate@127.0.0.1:5432/plate
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
